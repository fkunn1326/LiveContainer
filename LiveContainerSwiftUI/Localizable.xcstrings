          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此App移动到AppGroup以允许其他LiveContainers运行此App，并保留其所有数据和模块。如果你想访问它的数据和模块，请将其转换为私有App。"
          }
