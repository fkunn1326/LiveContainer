    "lc.settings.patchStoreDesc %@ %@ %@ %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use JIT-Less mode with %@, you must patch %@ in order to retrieve certificate. %@’s functions will not be affected. Please confirm that you can refresh %@ before applying the patch. Continue?"
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了通过%@获取证书以配置免JIT模式，你必须要给%@打补丁。%@的功能不会受到任何影响。请确保在打补丁前%@可以正常刷新。要继续吗？"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать режим JIT-less с %@, вы должны применить патч к магазину приложений %@ для получения сертификата магазина. Это не повлияет на работу %@. Пожалуйста, подтвердите, что вы у вас есть возможность переподписать (refresh) %@ перед применением патча. Продолжить?"
          }
        }
      }
    },
